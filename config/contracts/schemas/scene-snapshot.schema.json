{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/scene-snapshot/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "revision", "coordinateSystem", "entities"],
  "properties": {
    "schemaVersion": { "const": 1 }, "documentId": { "$ref": "#/definitions/id" },
    "revision": { "type": "integer", "minimum": 0 }, "coordinateSystem": { "const": "right-handed-y-up" },
    "entities": { "type": "array", "items": { "$ref": "#/definitions/entity" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "vector": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "transform": {
      "type": "object", "additionalProperties": false, "required": ["position", "rotationDegrees", "scale"],
      "properties": { "position": { "$ref": "#/definitions/vector" }, "rotationDegrees": { "$ref": "#/definitions/vector" }, "scale": { "$ref": "#/definitions/vector" } }
    },
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "primitive", "parentId", "transform", "scriptId"],
      "properties": {
        "id": { "$ref": "#/definitions/id" }, "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "primitive": { "enum": ["empty", "cube"] },
        "parentId": { "anyOf": [{ "$ref": "#/definitions/id" }, { "type": "null" }] },
        "transform": { "$ref": "#/definitions/transform" },
        "scriptId": { "anyOf": [{ "$ref": "#/definitions/id" }, { "type": "null" }] }
      }
    }
  }
}
