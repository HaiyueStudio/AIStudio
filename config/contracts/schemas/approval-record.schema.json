{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/approval-record/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "approvalId", "toolCallId", "toolId", "toolVersion", "effect", "argsDigest", "previewDigest", "documentId", "baseRevision", "expiresAt", "decision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "approvalId": { "$ref": "#/definitions/id" }, "toolCallId": { "$ref": "#/definitions/id" },
    "toolId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
    "toolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "effect": { "enum": ["reversible-edit", "trusted-code", "runtime-start"] },
    "argsDigest": { "$ref": "#/definitions/digest" }, "previewDigest": { "$ref": "#/definitions/digest" },
    "documentId": { "$ref": "#/definitions/id" }, "baseRevision": { "type": "integer", "minimum": 0 },
    "expiresAt": { "type": "string", "minLength": 20 },
    "decision": { "enum": ["pending", "allow-once", "reject", "cancel", "expired", "stale", "unavailable"] }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
