{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/profile-definition/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "plugins", "patches"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/definitions/id" },
    "plugins": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "patches": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["pluginId", "config"],
        "properties": { "pluginId": { "$ref": "#/definitions/id" }, "config": { "type": "object" } }
      }
    }
  },
  "definitions": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" } }
}
