{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/ipc-message/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "direction", "channel", "correlationId", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 }, "direction": { "enum": ["request", "response", "notification"] },
    "channel": { "type": "string", "pattern": "^studio:[a-z][a-z0-9./-]{2,95}$" },
    "id": { "$ref": "#/definitions/id" }, "correlationId": { "$ref": "#/definitions/id" },
    "payload": { "type": "object" }
  },
  "definitions": { "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" } }
}
