{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/context-frame/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "sessionId", "turnId", "backendBindingId", "model", "surfaceGeneration", "projectRevision", "inputs", "pressure", "cachePrefixDigest", "compaction", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "$ref": "haiyue://contracts/m13-common/v1#/definitions/stableId" }, "sessionId": { "$ref": "haiyue://contracts/m13-common/v1#/definitions/stableId" }, "turnId": { "$ref": "haiyue://contracts/m13-common/v1#/definitions/stableId" }, "backendBindingId": { "$ref": "haiyue://contracts/m13-common/v1#/definitions/stableId" },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 }, "surfaceGeneration": { "type": "integer", "minimum": 0 }, "projectRevision": { "$ref": "haiyue://contracts/m13-common/v1#/definitions/nullableRevision" },
    "inputs": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/definitions/input" } }, "pressure": { "$ref": "#/definitions/pressure" }, "cachePrefixDigest": { "$ref": "haiyue://contracts/m13-common/v1#/definitions/digest" },
    "compaction": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/compaction" }] }, "createdAt": { "$ref": "haiyue://contracts/m13-common/v1#/definitions/timestamp" }
  },
  "definitions": {
    "input": { "type": "object", "additionalProperties": false, "required": ["kind", "artifactId", "digest", "sourceRevision", "estimatedTokens", "required"], "properties": { "kind": { "enum": ["surface", "policy", "tool-catalog", "scene-snapshot", "scene-diff", "diagnostics-delta", "evidence-delta", "durable-memory", "knowledge-hit"] }, "artifactId": { "$ref": "haiyue://contracts/m13-common/v1#/definitions/stableId" }, "digest": { "$ref": "haiyue://contracts/m13-common/v1#/definitions/digest" }, "sourceRevision": { "$ref": "haiyue://contracts/m13-common/v1#/definitions/nullableRevision" }, "estimatedTokens": { "type": "integer", "minimum": 0 }, "required": { "type": "boolean" } } },
    "pressure": { "type": "object", "additionalProperties": false, "required": ["maxInputTokens", "reservedOutputTokens", "reservedSafetyTokens", "usedInputTokens", "ratio", "measurement", "state"], "properties": { "maxInputTokens": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1024, "maximum": 100000000 }] }, "reservedOutputTokens": { "type": "integer", "minimum": 0 }, "reservedSafetyTokens": { "type": "integer", "minimum": 0 }, "usedInputTokens": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] }, "ratio": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 1 }] }, "measurement": { "enum": ["provider-reported", "tokenizer-estimated", "unavailable"] }, "state": { "enum": ["normal", "warning", "preparing", "compact-required", "emergency", "unknown"] } } },
    "compaction": { "type": "object", "additionalProperties": false, "required": ["id", "reason", "coveredStartSequence", "coveredEndSequence", "before", "after", "sourceSurfaceGeneration", "targetSurfaceGeneration", "summaryArtifactId", "pinnedFactDigests", "validation", "diagnostic"], "properties": { "id": { "$ref": "haiyue://contracts/m13-common/v1#/definitions/stableId" }, "reason": { "enum": ["automatic-threshold", "manual", "provider-required"] }, "coveredStartSequence": { "type": "integer", "minimum": 0 }, "coveredEndSequence": { "type": "integer", "minimum": 0 }, "before": { "$ref": "#/definitions/pressure" }, "after": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/pressure" }] }, "sourceSurfaceGeneration": { "type": "integer", "minimum": 0 }, "targetSurfaceGeneration": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] }, "summaryArtifactId": { "$ref": "haiyue://contracts/m13-common/v1#/definitions/nullableStableId" }, "pinnedFactDigests": { "type": "array", "maxItems": 1024, "uniqueItems": true, "items": { "$ref": "haiyue://contracts/m13-common/v1#/definitions/digest" } }, "validation": { "enum": ["pending", "passed", "failed"] }, "diagnostic": { "anyOf": [{ "type": "null" }, { "enum": ["session.version-unsupported", "session.sequence-gap", "session.outcome-unknown", "surface.replace-range-invalid", "surface.source-missing", "context.capacity-unavailable", "context.compaction-unsafe", "context.compaction-summary-invalid", "tool-batch.cycle", "tool-batch.limit-exceeded", "tool-batch.concurrency-unknown", "scene-diff.revision-gap", "execution-graph.orphan-edge", "knowledge.source-stale", "knowledge.source-untrusted"] }] } } }
  }
}
