{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/plugin-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "apiVersion", "capabilities", "contributions", "activationPolicy", "config"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "apiVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "capabilities": {
      "type": "object", "additionalProperties": false, "required": ["required", "optional"],
      "properties": {
        "required": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" } },
        "optional": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" } }
      }
    },
    "contributions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" } },
    "activationPolicy": { "enum": ["required", "default", "on-demand"] },
    "config": { "type": "object" }
  }
}
