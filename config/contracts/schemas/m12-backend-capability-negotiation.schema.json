{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/backend-capability-negotiation/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "backendId", "protocolVersion", "requested", "status", "effective", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "backendId": { "$ref": "#/definitions/stableId" },
    "protocolVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "requested": { "$ref": "haiyue://contracts/agent-turn-config/v2" },
    "status": { "enum": ["accepted", "degraded", "rejected"] },
    "effective": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "reasoningEffort", "outputTokenLimit", "capabilities"],
          "properties": {
            "model": { "type": "string", "minLength": 1, "maxLength": 128 },
            "reasoningEffort": { "enum": ["backend-default", "off", "low", "medium", "high", "xhigh"] },
            "outputTokenLimit": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "capabilities": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "haiyue://contracts/m12-capability-id/v2" } }
          }
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
          "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "capability": { "$ref": "haiyue://contracts/m12-capability-id/v2" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "rejected" } } },
      "then": { "properties": { "effective": { "type": "null" }, "diagnostics": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["accepted", "degraded"] } } },
      "then": { "properties": { "effective": { "type": "object" } } }
    }
  ],
  "definitions": {
    "stableId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" }
  }
}
