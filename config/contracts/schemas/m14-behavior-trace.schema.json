{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/behavior-trace/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceBindingDigest",
    "manifestDigest",
    "playId",
    "generation",
    "events",
    "truncation",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceBindingDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "playId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "entityId",
          "componentId",
          "scriptId",
          "nodeId",
          "kind",
          "event",
          "tick",
          "frame",
          "durationMicros",
          "stateDiff",
          "error"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "entityId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "componentId": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              }
            ]
          },
          "scriptId": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              }
            ]
          },
          "nodeId": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              }
            ]
          },
          "kind": {
            "enum": [
              "event",
              "node-enter",
              "node-exit",
              "state-diff",
              "error",
              "cancel"
            ]
          },
          "event": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            ]
          },
          "tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "durationMicros": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            ]
          },
          "stateDiff": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "maxProperties": 64
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            ]
          }
        }
      },
      "maxItems": 10000
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truncated",
        "reasons",
        "omittedAtLeast"
      ],
      "properties": {
        "truncated": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "enum": [
              "nodes",
              "edges",
              "ast",
              "bytes",
              "events"
            ]
          },
          "maxItems": 5,
          "uniqueItems": true
        },
        "omittedAtLeast": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
