{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/game-document-query-result/v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "revision", "entities", "components", "nextCursor", "scanned"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "documentId": { "$ref": "haiyue://contracts/game-document/v2#/definitions/stableId" },
    "revision": { "type": "integer", "minimum": 0 },
    "entities": { "type": "array", "maxItems": 1000, "items": { "$ref": "haiyue://contracts/game-document/v2#/properties/entities/items" } },
    "components": { "type": "array", "maxItems": 256000, "items": { "$ref": "haiyue://contracts/game-component-instance/v2" } },
    "nextCursor": { "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 256 }] },
    "scanned": { "type": "integer", "minimum": 0 }
  }
}
