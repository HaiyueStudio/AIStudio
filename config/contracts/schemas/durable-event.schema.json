{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/durable-event/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "sequence", "timestamp", "kind", "severity", "source", "correlation", "payload", "redactedFields"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "$ref": "#/definitions/id" },
    "sequence": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "minLength": 20 },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9./-]{2,95}$" },
    "severity": { "enum": ["debug", "info", "warning", "error"] },
    "source": { "$ref": "#/definitions/id" },
    "correlation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "sessionId": { "$ref": "#/definitions/id" }, "turnId": { "$ref": "#/definitions/id" },
        "stepId": { "$ref": "#/definitions/id" }, "toolCallId": { "$ref": "#/definitions/id" },
        "approvalId": { "$ref": "#/definitions/id" }, "pluginId": { "$ref": "#/definitions/id" },
        "commandId": { "$ref": "#/definitions/id" }, "transactionId": { "$ref": "#/definitions/id" },
        "documentId": { "$ref": "#/definitions/id" }, "entityId": { "$ref": "#/definitions/id" }
      }
    },
    "payload": { "type": "object" },
    "redactedFields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "definitions": { "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" } }
}
