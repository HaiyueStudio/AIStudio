{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/editor-location/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "documentId",
    "documentRevision",
    "sourceBindingDigest",
    "target"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "documentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "documentRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceBindingDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entityId"
          ],
          "properties": {
            "kind": {
              "const": "entity"
            },
            "entityId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entityId",
            "componentId",
            "componentVersion",
            "field"
          ],
          "properties": {
            "kind": {
              "const": "component"
            },
            "entityId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            },
            "componentId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            },
            "componentVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "field": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source"
          ],
          "properties": {
            "kind": {
              "const": "script"
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "entityId",
                "scriptId",
                "digest",
                "path",
                "range"
              ],
              "properties": {
                "kind": {
                  "const": "script"
                },
                "entityId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                },
                "scriptId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "path": {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:])[A-Za-z0-9._ /-]+\\.tsx?$"
                },
                "range": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "end",
                    "startLine",
                    "startColumn",
                    "endLine",
                    "endColumn"
                  ],
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "startLine": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "startColumn": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "endColumn": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "resource"
            },
            "ref": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "assetId",
                    "digest",
                    "source"
                  ],
                  "properties": {
                    "kind": {
                      "const": "asset"
                    },
                    "assetId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "source": {
                      "enum": [
                        "builtin",
                        "project",
                        "imported"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "templateId",
                    "registryVersion",
                    "defaultsDigest"
                  ],
                  "properties": {
                    "kind": {
                      "const": "template"
                    },
                    "templateId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "registryVersion": {
                      "type": "string",
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                    },
                    "defaultsDigest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "presetId",
                    "schemaId",
                    "schemaVersion",
                    "valueDigest"
                  ],
                  "properties": {
                    "kind": {
                      "const": "preset"
                    },
                    "presetId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "schemaId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "schemaVersion": {
                      "type": "string",
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                    },
                    "valueDigest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "projectId",
                    "entityId",
                    "documentRevision",
                    "componentId"
                  ],
                  "properties": {
                    "kind": {
                      "const": "instance"
                    },
                    "projectId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "entityId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "documentRevision": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "componentId": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "manifestDigest",
            "nodeId",
            "source"
          ],
          "properties": {
            "kind": {
              "const": "behavior-node"
            },
            "manifestDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "nodeId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            },
            "source": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "entityId",
                    "scriptId",
                    "digest",
                    "path",
                    "range"
                  ],
                  "properties": {
                    "kind": {
                      "const": "script"
                    },
                    "entityId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "scriptId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "path": {
                      "type": "string",
                      "maxLength": 512,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:])[A-Za-z0-9._ /-]+\\.tsx?$"
                    },
                    "range": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "start",
                        "end",
                        "startLine",
                        "startColumn",
                        "endLine",
                        "endColumn"
                      ],
                      "properties": {
                        "start": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "startLine": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "startColumn": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "endLine": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "endColumn": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "entityId",
                    "componentId",
                    "componentType",
                    "componentVersion",
                    "field"
                  ],
                  "properties": {
                    "kind": {
                      "const": "declarative-component"
                    },
                    "entityId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "componentId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "componentType": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "componentVersion": {
                      "type": "string",
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                    },
                    "field": {
                      "type": "string",
                      "maxLength": 512,
                      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "entityId",
                    "componentId",
                    "adapter",
                    "field"
                  ],
                  "properties": {
                    "kind": {
                      "const": "runtime-adapter"
                    },
                    "entityId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "componentId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "adapter": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "version",
                        "digest"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                        },
                        "version": {
                          "type": "string",
                          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        }
                      }
                    },
                    "field": {
                      "type": "string",
                      "maxLength": 512,
                      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "artifactId",
            "digest"
          ],
          "properties": {
            "kind": {
              "const": "evidence"
            },
            "artifactId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      ]
    }
  }
}
