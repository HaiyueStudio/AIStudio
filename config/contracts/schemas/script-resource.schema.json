{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/script-resource/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "language", "source", "digest", "validation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 96 }, "language": { "const": "typescript" },
    "source": { "type": "string", "maxLength": 262144 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "validation": { "enum": ["unknown", "valid", "invalid"] }
  }
}
