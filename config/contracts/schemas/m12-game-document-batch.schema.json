{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/game-document-batch/v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "label", "documentId", "baseRevision", "operations"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "$ref": "haiyue://contracts/game-document/v2#/definitions/stableId" },
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "documentId": { "$ref": "haiyue://contracts/game-document/v2#/definitions/stableId" },
    "baseRevision": { "type": "integer", "minimum": 0 },
    "operations": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "haiyue://contracts/game-document-operation/v2" } }
  }
}
