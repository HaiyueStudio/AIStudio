{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/pricing-catalog/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "effectiveAt", "currency", "sources", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/definitions/stableId" },
    "version": { "$ref": "#/definitions/semver" },
    "effectiveAt": { "$ref": "#/definitions/timestamp" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "url", "retrievedAt"],
        "properties": {
          "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
          "url": { "type": "string", "pattern": "^https://" },
          "retrievedAt": { "$ref": "#/definitions/timestamp" }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model", "inputMicrosPerMillion", "cachedInputMicrosPerMillion", "cacheWriteMicrosPerMillion", "outputMicrosPerMillion", "reasoningBilling"],
        "properties": {
          "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
          "model": { "type": "string", "minLength": 1, "maxLength": 128 },
          "inputMicrosPerMillion": { "$ref": "#/definitions/micros" },
          "cachedInputMicrosPerMillion": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/micros" }] },
          "cacheWriteMicrosPerMillion": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/micros" }] },
          "outputMicrosPerMillion": { "$ref": "#/definitions/micros" },
          "reasoningBilling": { "enum": ["included-in-output", "separate-as-output"] }
        }
      }
    }
  },
  "definitions": {
    "stableId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$" },
    "micros": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
