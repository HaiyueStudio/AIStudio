{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/project-command/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "documentId", "baseRevision", "label", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "commandId": { "$ref": "#/definitions/id" }, "documentId": { "$ref": "#/definitions/id" },
    "baseRevision": { "type": "integer", "minimum": 0 }, "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "payload": { "type": "object" }
  },
  "definitions": { "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" } }
}
