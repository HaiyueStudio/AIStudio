{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/subtask-candidate/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "baseRevision",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "kind",
          "content",
          "sources"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "enum": [
              "proposal",
              "patch",
              "test"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    }
  }
}
