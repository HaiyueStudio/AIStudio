{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/plan-task/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "dependsOn",
    "inputs",
    "artifacts",
    "readScopes",
    "writeScopes",
    "verification",
    "budget",
    "estimatedWorkMs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "dependsOn": {
      "type": "array",
      "maxItems": 19,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "readScopes": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "writeScopes": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "verification": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolCalls",
        "wallTimeMs"
      ],
      "properties": {
        "toolCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "wallTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "estimatedWorkMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
