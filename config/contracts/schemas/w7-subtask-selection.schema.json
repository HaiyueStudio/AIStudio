{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/subtask-selection/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
      }
    }
  }
}
