{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/behavior-explanation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestDigest",
    "language",
    "producerVersion",
    "producer",
    "entries",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{2,8})*$",
      "maxLength": 32
    },
    "producerVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "producer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "templateVersion"
          ],
          "properties": {
            "kind": {
              "const": "verified-structure"
            },
            "templateVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "model",
            "profile"
          ],
          "properties": {
            "kind": {
              "const": "agent-claim"
            },
            "model": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              ]
            },
            "profile": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              ]
            }
          }
        }
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "text",
          "evidence"
        ],
        "properties": {
          "nodeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "evidence": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "entityId",
                    "scriptId",
                    "digest",
                    "path",
                    "range"
                  ],
                  "properties": {
                    "kind": {
                      "const": "script"
                    },
                    "entityId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "scriptId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "path": {
                      "type": "string",
                      "maxLength": 512,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:])[A-Za-z0-9._ /-]+\\.tsx?$"
                    },
                    "range": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "start",
                        "end",
                        "startLine",
                        "startColumn",
                        "endLine",
                        "endColumn"
                      ],
                      "properties": {
                        "start": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "startLine": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "startColumn": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "endLine": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "endColumn": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "entityId",
                    "componentId",
                    "componentType",
                    "componentVersion",
                    "field"
                  ],
                  "properties": {
                    "kind": {
                      "const": "declarative-component"
                    },
                    "entityId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "componentId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "componentType": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "componentVersion": {
                      "type": "string",
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                    },
                    "field": {
                      "type": "string",
                      "maxLength": 512,
                      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "entityId",
                    "componentId",
                    "adapter",
                    "field"
                  ],
                  "properties": {
                    "kind": {
                      "const": "runtime-adapter"
                    },
                    "entityId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "componentId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                    },
                    "adapter": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "version",
                        "digest"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
                        },
                        "version": {
                          "type": "string",
                          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$"
                        }
                      }
                    },
                    "field": {
                      "type": "string",
                      "maxLength": 512,
                      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                    }
                  }
                }
              ]
            },
            "maxItems": 16
          }
        }
      },
      "maxItems": 2000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
