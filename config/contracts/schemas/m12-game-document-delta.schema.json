{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/game-document-delta/v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "transactionId", "documentId", "beforeRevision", "afterRevision", "operations", "inverse", "metrics"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "transactionId": { "$ref": "haiyue://contracts/game-document/v2#/definitions/stableId" },
    "documentId": { "$ref": "haiyue://contracts/game-document/v2#/definitions/stableId" },
    "beforeRevision": { "type": "integer", "minimum": 0 },
    "afterRevision": { "type": "integer", "minimum": 1 },
    "operations": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "haiyue://contracts/game-document-operation/v2" } },
    "inverse": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "haiyue://contracts/game-document-operation/v2" } },
    "metrics": { "type": "object", "additionalProperties": false, "required": ["copiedBytes", "historyBytes", "projectionWork", "durationMicros"], "properties": { "copiedBytes": { "type": "integer", "minimum": 0 }, "historyBytes": { "type": "integer", "minimum": 0 }, "projectionWork": { "type": "integer", "minimum": 0 }, "durationMicros": { "type": "integer", "minimum": 0 } } }
  }
}
