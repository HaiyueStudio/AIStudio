{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/parametric-array/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "arrayId",
    "representation",
    "layout",
    "template"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1
      ]
    },
    "arrayId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$"
    },
    "representation": {
      "enum": [
        "entities",
        "instances"
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rows",
        "columns"
      ],
      "properties": {
        "kind": {
          "enum": [
            "grid"
          ]
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "plane": {
          "enum": [
            "xy",
            "xz",
            "yz"
          ]
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "y": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "z": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            }
          }
        },
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0.0001,
              "maximum": 100000
            },
            "y": {
              "type": "number",
              "minimum": 0.0001,
              "maximum": 100000
            }
          }
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cube",
            "rounded-box",
            "sphere",
            "cone",
            "cylinder",
            "plane",
            "torus",
            "icosahedron"
          ]
        },
        "material": {
          "enum": [
            "basic",
            "pbr",
            "blinn-phong",
            "normal"
          ]
        },
        "color": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "palette": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "rotationDegrees": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "y": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "z": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            }
          }
        },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "y": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "z": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            }
          }
        },
        "plane": {
          "enum": [
            "xy",
            "xz",
            "yz"
          ]
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "segments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "components": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "version",
              "value"
            ],
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^haiyue\\.[a-z0-9.-]+$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "value": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
