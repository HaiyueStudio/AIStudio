{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "haiyue://contracts/tool-definition/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "effect", "risk", "requiredCapabilities", "inputSchema", "outputSchema", "redactedFields"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "effect": { "enum": ["observe", "reversible-edit", "trusted-code", "runtime-start"] },
    "risk": { "enum": ["low", "medium", "high"] },
    "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" } },
    "inputSchema": { "type": "object" }, "outputSchema": { "type": "object" },
    "redactedFields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
