{
  "name": "@haiyue/ai-studio-repository",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "workspaces": ["packages/*", "apps/*"],
  "dependencies": {
    "@haiyue/editor-app-kit": "file:vendor/haiyue-editor-app-kit-0.1.0.tgz",
    "@haiyue/editor-platform": "file:vendor/haiyue-editor-platform-0.1.0.tgz",
    "@haiyue/editor-plugin-sdk": "file:vendor/haiyue-editor-plugin-sdk-0.1.0.tgz",
    "@haiyue/editor-shell": "file:vendor/haiyue-editor-shell-0.1.0.tgz"
  },
  "scripts": {
    "contracts:check": "node scripts/verify-contracts.mjs",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "upstream:check": "node scripts/verify-upstream-pins.mjs",
    "editor:candidate:check": "node scripts/verify-editor-candidates.mjs",
    "spike:check": "node scripts/verify-protocol-spikes.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run contracts:check && npm run typecheck && npm run boundaries:check && npm run upstream:check && npm run spike:check",
    "g01:check": "npm run check && npm run editor:candidate:check",
    "codex:schema:generate": "node scripts/generate-codex-schema.mjs",
    "g10:evidence:check": "node scripts/verify-g10-evidence.mjs"
  },
  "devDependencies": {
    "@openai/codex": "0.148.0",
    "ajv": "8.20.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.7"
  }
}
