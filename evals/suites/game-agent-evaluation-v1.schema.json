{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haiyuestudio.local/schemas/game-agent-evaluation-v1.schema.json",
  "title": "AI-native game authoring agent evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteId", "version", "title", "oracleVisibility", "sharedEnvironment", "sharedBudgets", "cases"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "suiteId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "oracleVisibility": { "const": "runner-only" },
    "sharedEnvironment": { "$ref": "#/$defs/environment" },
    "sharedBudgets": { "$ref": "#/$defs/budgets" },
    "cases": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectTemplate", "viewport", "simulationHz", "seed", "assetPolicy", "modes"],
      "properties": {
        "projectTemplate": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 320 },
            "height": { "type": "integer", "minimum": 240 }
          }
        },
        "simulationHz": { "type": "integer", "minimum": 15, "maximum": 240 },
        "seed": { "type": "integer", "minimum": 0 },
        "assetPolicy": { "enum": ["builtin-or-procedural-only", "fixture-pack"] },
        "modes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["cold-create", "warm-repair", "seeded-defect"] }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAgentTurns", "maxToolCalls", "maxRepairIterations", "maxWallTimeMs", "maxObservationBytes", "costPolicy"],
      "properties": {
        "maxAgentTurns": { "type": "integer", "minimum": 1 },
        "maxToolCalls": { "type": "integer", "minimum": 1 },
        "maxRepairIterations": { "type": "integer", "minimum": 0 },
        "maxWallTimeMs": { "type": "integer", "minimum": 1000 },
        "maxObservationBytes": { "type": "integer", "minimum": 1024 },
        "costPolicy": { "enum": ["record-only", "hard-limit"] }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "genre", "title", "request", "requestVariants", "agentVisibleConstraints", "requiredCapabilities", "inputReplay", "acceptance", "failureSeeds"],
      "properties": {
        "id": { "type": "string", "pattern": "^game-eval:[a-z0-9-]+:v[0-9]+$" },
        "genre": { "enum": ["snake", "match-3", "falling-blocks", "jigsaw", "platformer", "racing", "shooter"] },
        "title": { "type": "string", "minLength": 1 },
        "request": { "type": "string", "minLength": 20 },
        "requestVariants": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/requestVariant" } },
        "agentVisibleConstraints": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "requiredCapabilities": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$" }
        },
        "inputReplay": { "$ref": "#/$defs/inputReplay" },
        "acceptance": { "$ref": "#/$defs/acceptance" },
        "failureSeeds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/failureSeed" } },
        "budgetOverrides": { "$ref": "#/$defs/budgets" }
      }
    },
    "requestVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "request"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "request": { "type": "string", "minLength": 20 }
      }
    },
    "inputReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "steps"],
      "properties": {
        "driver": { "enum": ["fixed", "oracle-assisted"] },
        "steps": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/replayStep" } }
      }
    },
    "replayStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "control": { "type": "string", "minLength": 1 },
        "durationTicks": { "type": "integer", "minimum": 0 },
        "parameters": { "type": "object" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functional", "visual", "robustness"],
      "properties": {
        "functional": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/assertion" } },
        "visual": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } },
        "robustness": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assertion", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
        "assertion": { "type": "string", "minLength": 10 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["state", "event-trace", "input-replay", "screenshot", "performance", "lifecycle", "log"] }
        }
      }
    },
    "failureSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "expectedFailedAcceptanceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 10 },
        "expectedFailedAcceptanceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
