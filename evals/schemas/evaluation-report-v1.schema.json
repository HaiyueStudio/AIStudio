{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haiyuestudio.local/schemas/evaluation-report-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteId", "suiteVersion", "suiteDigest", "runnerVersion", "summary", "runs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suiteId": { "type": "string", "minLength": 1 },
    "suiteVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "suiteDigest": { "$ref": "#/$defs/digest" },
    "runnerVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "runId", "caseId", "genre", "variantId", "mode", "seed", "requestDigest", "blankProjectDigest", "status", "acceptanceResults", "evidenceManifestDigest", "evidenceCount", "observationBytes", "execution", "accounting"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "runId": { "type": "string", "pattern": "^eval-run:[a-f0-9]{16}$" },
        "caseId": { "type": "string", "pattern": "^game-eval:[a-z0-9-]+:v[0-9]+$" },
        "genre": { "enum": ["snake", "match-3", "falling-blocks", "jigsaw", "platformer", "racing", "shooter"] },
        "variantId": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["cold-create", "warm-repair", "seeded-defect"] },
        "failureSeedId": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "blankProjectDigest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["pass", "fail"] },
        "acceptanceResults": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/acceptanceResult" } },
        "evidenceManifestDigest": { "$ref": "#/$defs/digest" },
        "evidenceCount": { "type": "integer", "minimum": 0 },
        "observationBytes": { "type": "integer", "minimum": 0 },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resetRevision", "terminal", "turns", "toolCalls", "replaySteps", "isolationChecks"],
          "properties": {
            "resetRevision": { "type": "integer", "minimum": 0 },
            "terminal": { "type": "string", "minLength": 1 },
            "turns": { "type": "integer", "minimum": 0 },
            "toolCalls": { "type": "integer", "minimum": 0 },
            "replaySteps": { "type": "integer", "minimum": 0 },
            "isolationChecks": { "type": "integer", "minimum": 0 }
          }
        },
        "accounting": { "$ref": "#/$defs/accounting" }
      }
    },
    "stableId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "budgetId", "budgetStatus", "usageRecordIds", "costRecordIds", "turns", "tools"],
      "properties": {
        "taskId": { "$ref": "#/$defs/stableId" },
        "budgetId": { "$ref": "#/$defs/stableId" },
        "budgetStatus": { "enum": ["within", "soft-exceeded", "hard-exceeded"] },
        "usageRecordIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "costRecordIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "turns": { "type": "array", "items": { "$ref": "#/$defs/turnAccounting" } },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/toolAccounting" } }
      }
    },
    "turnAccounting": {
      "type": "object", "additionalProperties": false,
      "required": ["turnId", "usageRecordIds", "finishReason"],
      "properties": { "turnId": { "$ref": "#/$defs/stableId" }, "usageRecordIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } }, "finishReason": { "enum": ["stop", "length", "tool-calls", "cancelled", "content-filter", "error", "unknown"] } }
    },
    "toolAccounting": {
      "type": "object", "additionalProperties": false,
      "required": ["toolCallId", "turnId", "usageRecordIds"],
      "properties": { "toolCallId": { "$ref": "#/$defs/stableId" }, "turnId": { "$ref": "#/$defs/stableId" }, "usageRecordIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } } }
    },
    "acceptanceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptanceId", "status", "evidenceIds", "diagnosticCodes"],
      "properties": {
        "acceptanceId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail"] },
        "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "diagnosticCodes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
