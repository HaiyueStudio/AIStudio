{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:haiyue:design:intent-proposal:0.1",
  "title": "IntentProposal 0.1 — design draft, not a production contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "goals", "targets", "requirements"],
  "properties": {
    "version": { "const": "intent/0.1" },
    "goals": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/definitions/goal" } },
    "targets": { "type": "array", "maxItems": 32, "items": { "$ref": "#/definitions/target" } },
    "requirements": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/definitions/requirement" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9:-]{0,95}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "refs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["messageRef", "start", "end"],
      "properties": {
        "messageRef": { "$ref": "#/definitions/id" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "goal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "action", "domain", "targetRefs", "requirementRefs", "dependsOn"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "action": { "enum": ["explain", "inspect", "create", "modify", "delete", "validate", "unknown"] },
        "domain": { "enum": ["scene", "appearance", "camera", "gameplay", "physics", "assets", "project", "unknown"] },
        "targetRefs": { "$ref": "#/definitions/refs" },
        "requirementRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
        "dependsOn": { "$ref": "#/definitions/refs" }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "selector", "source"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "source": { "$ref": "#/definitions/source" },
        "selector": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "selection" } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "value", "cardinality"], "properties": { "kind": { "const": "name" }, "value": { "$ref": "#/definitions/text" }, "cardinality": { "enum": ["one", "many"] } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "ref"], "properties": { "kind": { "const": "fact" }, "ref": { "$ref": "#/definitions/id" } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "of", "universe"], "properties": { "kind": { "const": "complement" }, "of": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } }, "universe": { "const": "document.entities" } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "phrase"], "properties": { "kind": { "const": "unresolved" }, "phrase": { "$ref": "#/definitions/text" } } }
          ]
        }
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "predicate"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "source": { "$ref": "#/definitions/source" },
        "predicate": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "targetRef", "property", "operator", "value", "unit"],
              "properties": {
                "kind": { "const": "compare" }, "targetRef": { "$ref": "#/definitions/id" },
                "property": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$", "maxLength": 128 },
                "operator": { "enum": ["eq", "gte", "lte"] },
                "value": { "type": ["string", "number", "boolean"], "maxLength": 1024 },
                "unit": { "enum": ["none", "s", "ms", "m", "deg", "count", "hex-srgb"] }
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "action", "scope"],
              "properties": { "kind": { "const": "prohibit" }, "action": { "enum": ["create", "modify", "delete"] }, "scope": { "enum": ["document", "document.entities"] } }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "targetRef", "baseline", "extent"],
              "properties": { "kind": { "const": "preserve" }, "targetRef": { "$ref": "#/definitions/id" }, "baseline": { "const": "request-snapshot" }, "extent": { "const": "authored-state" } }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "text"],
              "properties": { "kind": { "enum": ["answer", "observe", "unresolved"] }, "text": { "$ref": "#/definitions/text" } }
            }
          ]
        }
      }
    }
  }
}
