{
  "name": "@haiyue/ai-studio-agent-backends",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "pretypecheck": "npm run build -w @haiyue/ai-studio-contracts && npm run build -w @haiyue/ai-studio-agent-runtime && npm run build -w @haiyue/ai-studio-harness-bridge",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "npm run build -w @haiyue/ai-studio-contracts && npm run build -w @haiyue/ai-studio-agent-runtime && npm run build -w @haiyue/ai-studio-harness-bridge",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke:deepseek": "npm run build && node test/deepseek-real.smoke.mjs"
  },
  "dependencies": {
    "@haiyue/ai-studio-agent-runtime": "0.0.0",
    "@haiyue/ai-studio-contracts": "0.0.0",
    "@haiyue/ai-studio-harness-bridge": "0.0.0",
    "@openai/codex": "0.148.0"
  },
  "devDependencies": { "@types/node": "22.19.13", "ajv": "8.20.0" }
}
