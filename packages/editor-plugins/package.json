{
  "name": "@haiyue/ai-studio-editor-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./project": { "types": "./dist/project/index.d.ts", "import": "./dist/project/index.js" },
    "./history": { "types": "./dist/history/index.d.ts", "import": "./dist/history/index.js" },
    "./components": { "types": "./dist/components/index.d.ts", "import": "./dist/components/index.js" },
    "./scene-authoring": { "types": "./dist/scene-authoring.d.ts", "import": "./dist/scene-authoring.js" },
    "./camera-authoring": { "types": "./dist/camera-authoring.d.ts", "import": "./dist/camera-authoring.js" }
  },
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "pretypecheck": "npm run build -w @haiyue/ai-studio-contracts && npm run build -w @haiyue/ai-studio-kernel && npm run build -w @haiyue/ai-studio-operation-log",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "npm run build -w @haiyue/ai-studio-contracts && npm run build -w @haiyue/ai-studio-kernel && npm run build -w @haiyue/ai-studio-operation-log",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@haiyue/ai-studio-contracts": "0.0.0",
    "@haiyue/ai-studio-kernel": "0.0.0",
    "@haiyue/ai-studio-operation-log": "0.0.0",
    "@haiyue/engine": "0.1.0"
  },
  "peerDependencies": {
    "@haiyue/editor-platform": "0.1.0",
    "@haiyue/editor-plugin-sdk": "0.1.0"
  }
}
