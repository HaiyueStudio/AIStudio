{
  "name": "@haiyue/ai-studio-shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./script-editor": {
      "types": "./dist/script-editor.d.ts",
      "import": "./dist/script-editor.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conversation": {
      "types": "./dist/conversation/index.d.ts",
      "import": "./dist/conversation/index.js"
    },
    "./resources": {
      "types": "./dist/panels/resources/index.d.ts",
      "import": "./dist/panels/resources/index.js"
    },
    "./resources.css": "./dist/panels/resources/resources.css",
    "./advanced": {
      "types": "./dist/panels/advanced/index.d.ts",
      "import": "./dist/panels/advanced/index.js"
    },
    "./advanced/model": {
      "types": "./dist/panels/advanced/model.d.ts",
      "import": "./dist/panels/advanced/model.js"
    },
    "./resources/model": {
      "types": "./dist/panels/resources/model.d.ts",
      "import": "./dist/panels/resources/model.js"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "pretypecheck": "npm run build -w @haiyue/ai-studio-contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "npm run build -w @haiyue/ai-studio-contracts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test test/*.test.mjs test/resources/*.test.mjs test/advanced-editor/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@haiyue/ai-studio-contracts": "0.0.0",
    "@lezer/highlight": "1.2.3",
    "codemirror": "6.0.2",
    "prettier": "3.9.6"
  },
  "peerDependencies": {
    "@haiyue/editor-app-kit": "0.1.0",
    "@haiyue/editor-plugin-sdk": "0.1.0",
    "@haiyue/editor-shell": "0.1.1",
    "@haiyue/ui": ">=0.1.4 <0.2.0"
  }
}
